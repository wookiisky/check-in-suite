{
  "name": "little-growth-island",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "npm run dev",
    "test": "npm run test:go && npm run test:web && npm run test:deploy && npm run test:spec",
    "check": "npm run check:spec && npm run check:go && npm run typecheck",
    "dev": "concurrently --kill-others --success first --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "go run ./cmd/island serve -config config/app.example.yaml",
    "dev:web": "npm run dev --workspace @island/web --",
    "db:migrate": "go run ./cmd/island migrate -config config/app.example.yaml",
    "api:generate": "openapi-typescript api/openapi.yaml -o web/src/api/schema.d.ts",
    "api:check": "openapi-typescript api/openapi.yaml -o web/src/api/schema.d.ts --check",
    "typecheck": "npm run api:check && npm run typecheck --workspace @island/web",
    "test:go": "go test ./...",
    "test:race": "go test -race ./...",
    "test:web": "npm run test --workspace @island/web",
    "test:e2e": "playwright test",
    "check:go": "go vet ./...",
    "build:api": "go build -o .local/bin/island ./cmd/island",
    "build:web": "npm run build --workspace @island/web",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "release": "node scripts/release.mjs",
    "verify": "npm run check && npm run test:spec && npm run test:deploy && npm run test:race && npm run test:web && npm run build:web && npm run build:api && npm run test:e2e",
    "db:seed": "go run ./cmd/island migrate -config config/app.example.yaml && go run ./cmd/island seed-demo -config config/app.example.yaml",
    "db:status": "go run ./cmd/island db-status -config config/app.example.yaml",
    "deploy": "node scripts/deploy.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs scripts/release.test.mjs scripts/publish.test.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "test:spec": "node --test scripts/check-spec.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "openapi-typescript": "7.13.0"
  }
}
